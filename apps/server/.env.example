# ---- 服务 ----
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ---- 数据库（切换 mysql / postgresql 时同步修改 prisma/schema.prisma 的 provider）----
DATABASE_URL="file:../data/szb.db"

# ---- JWT ----
JWT_SECRET=dev-only-change-me-please-0123456789
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---- 上传 ----
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_PUBLIC_PATH=/uploads

# ---- 前台缓存 / 文档 ----
# public 聚合接口内存缓存秒数，0 = 关闭（本地联调建议 0）
PUBLIC_CACHE_TTL_SEC=60
# 接口文档 /api/docs，留空表示非 production 自动开放
SWAGGER_ENABLED=

# ---- seed ----
SEED_ADMIN_PASSWORD=Admin@123456
